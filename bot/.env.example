# ============================================================
#  Переменные Telegram-бота SAMNAZ
#  Файл-образец. Скопируйте в .env и заполните.
#  .env в git не попадает — он в .gitignore.
#
#  На проде (Cloudflare) эти же значения задаются командами:
#     wrangler secret put BOT_TOKEN
#     wrangler secret put BOT_LOGIN
#     wrangler secret put BOT_PASSWORD
#     wrangler secret put WEBHOOK_SECRET
# ============================================================

# Токен бота от @BotFather — сюда вставляете свой
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Логин и пароль, которые бот спросит после /start.
# Без них никто не подпишется на заявки.
BOT_LOGIN=samnaz
BOT_PASSWORD=смените-на-свой-пароль

# Случайная строка в адресе webhook, чтобы посторонние не слали боту фальшивые события.
# Сгенерировать: openssl rand -hex 24
WEBHOOK_SECRET=замените-на-случайную-строку

# Домен сайта: только с него принимаются заявки
ALLOWED_ORIGIN=https://samnaz.group
